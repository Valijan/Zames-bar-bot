{
  "framework": null,
  "buildCommand": "echo no-build",
  "installCommand": "echo no-install",
  "outputDirectory": "public",
  "functions": {
    "api/telegram.js": {
      "maxDuration": 300
    },
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/setup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron?stage=last",
      "schedule": "0 10 * * 4"
    }
  ]
}